{erl_opts, [debug_info]}.
{deps, [{epgsql, "4.8.0"}, {jargon, "1.1.0"}]}.

%% Supervisor child MFAs and shell entry points are valid public exports.
{xref_checks, [undefined_function_calls, undefined_functions, deprecated_function_calls]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [server]}
]}.
