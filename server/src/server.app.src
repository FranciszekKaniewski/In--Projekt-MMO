{application, server, [
    {description, "SDL game TLS server with account authentication"},
    {vsn, "0.1.0"},
    {registered, [server_sup, server_db, server_auth_guard, server_world,
                  server_connection_sup, server_listener]},
    {mod, {server_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        public_key,
        ssl,
        epgsql,
        jargon
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
 ]}.
