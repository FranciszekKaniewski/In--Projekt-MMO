{application, server, [
    {description, "SDL game TCP server"},
    {vsn, "0.1.0"},
    {registered, [server_sup, server_connection_sup, server_listener]},
    {mod, {server_app, []}},
    {applications, [
        kernel,
        stdlib
    ]},
    {env, [{ip, {127, 0, 0, 1}}, {port, 4000}]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
 ]}.
